# macOS
.DS_Store

# BigWigs packager output
/.release/

# Embedded libraries — fetched by the packager at release time (see .pkgmeta).
/Libs/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# luac -l byproduct
luac.out

# Personal action-bar icon art (GB.Icons overrides, IconsHD/). NEVER track this.
# The owner's own media does not ship in the addon — same rule as the suite's
# fonts and textures. The MECHANISM ships; the art does not.
/IconsHD/
